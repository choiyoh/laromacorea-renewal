{
  "name": "laromacorea-renewal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:run": "vitest --run",
    "test:coverage": "vitest --coverage",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "build:prod": "vite build --mode production",
    "deploy": "npm run pre-deploy-check && npm run build:prod && npx firebase-tools deploy",
    "deploy:hosting": "npm run pre-deploy-check && npm run build:prod && npx firebase-tools deploy --only hosting",
    "deploy:rules": "npx firebase-tools deploy --only firestore:rules,storage",
    "serve:local": "npx firebase-tools serve --only hosting",
    "emulators": "npx firebase-tools emulators:start",
    "pre-deploy-check": "node scripts/pre-deployment-check.js",
    "setup-firebase": "node scripts/setup-firebase.js",
    "add-sample-data": "node scripts/add-sample-data.js",
    "test-auth": "node scripts/test-auth.js",
    "create-test-users": "node scripts/create-test-users.js",
    "check-admin-user": "node scripts/check-admin-user.js",
    "update-posts-icons": "node scripts/update-existing-posts-icons.js",
    "check-user-icons": "node scripts/check-user-icons.js"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@unhead/vue": "^2.0.14",
    "@vueuse/head": "^2.0.0",
    "firebase": "^12.1.0",
    "lodash-es": "^4.17.21",
    "pinia": "^3.0.3",
    "quill": "^2.0.3",
    "vue": "^3.5.18",
    "vue-quill-editor": "^3.0.6",
    "vue-router": "^4.5.1",
    "vuetify": "^3.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/eslint-plugin": "^1.3.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.31.0",
    "eslint-plugin-vue": "~10.3.0",
    "firebase-tools": "^14.12.1",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "3.6.2",
    "sass-embedded": "^1.90.0",
    "vite": "^7.0.6",
    "vite-plugin-vue-devtools": "^8.0.0",
    "vitest": "^3.2.4"
  }
}
