rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) && 
                       request.resource.data.uid == request.auth.uid &&
                       request.resource.data.role == 'user';
      // Owners may edit their own profile, but privilege-bearing fields stay
      // admin-only: without this any signed-in user could set role: 'admin' on
      // their own document and inherit admin writes across the whole database.
      // Verified against the emulator - see the role/isActive cases.
      allow update: if isAdmin() ||
                       (isOwner(userId) &&
                        !request.resource.data
                          .diff(resource.data)
                          .affectedKeys()
                          .hasAny([
                            'role',
                            'isActive',
                            'verified',
                            'uid',
                            'createdAt',
                            'passwordResetRequired',
                            'passwordResetAt',
                          ]));
      allow delete: if isAdmin();
    }

    // Posts collection
    match /posts/{postId} {
      allow read: if true;
      allow create: if (isAuthenticated() && 
                       request.resource.data.authorId == request.auth.uid &&
                       request.resource.data.boardType in ['squad', 'match', 'calcio', 'free', 'special', 'media']) ||
                       (isAdmin() && request.resource.data.boardType == 'notice');
      allow update: if 
                       // Allow anyone to increment viewCount, and nothing else
                       (request.resource.data.viewCount == resource.data.viewCount + 1 &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount']))
                       ||
                       // Allow any authenticated user to sync commentCount, and nothing else
                       (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount']) &&
                        isAuthenticated())
                       ||
                       // Allow author/admin to perform other updates
                       ((isAuthenticated() && request.auth.uid == resource.data.authorId) || isAdmin());
      allow delete: if (isAuthenticated() && request.auth.uid == resource.data.authorId) || isAdmin();

      // Likes subcollection for posts
      match /likes/{userId} {
        allow read: if isAuthenticated();
        allow create, delete: if isOwner(userId);
        allow update: if false;
      }
    }

    // Comments collection
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
                       request.resource.data.authorId == request.auth.uid;
      allow update: if (isAuthenticated() && request.auth.uid == resource.data.authorId) || isAdmin();
      allow delete: if (isAuthenticated() && request.auth.uid == resource.data.authorId) || isAdmin();

      // Likes subcollection for comments
      match /likes/{userId} {
        allow read: if isAuthenticated();
        allow create, delete: if isOwner(userId);
        allow update: if false;
      }
    }

    // Icons collection
    match /icons/{iconId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || 
                       (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['purchaseCount']));
    }

    // Points history collection
    match /points_history/{historyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // User history collection
    match /userHistory/{historyId} {
      allow read: if (isAuthenticated() && request.auth.uid == resource.data.userId) || isAdmin();
      allow create: if isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow update, delete: if isAdmin();
    }

    // Boards collection (게시판 설정)
    match /boards/{boardId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // User purchased icons (subcollection)
    match /users/{userId}/purchased_icons/{iconId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update, delete: if false;
    }

    // User notifications (subcollection)
    match /users/{userId}/notifications/{notificationId} {
      allow read: if isOwner(userId);
      allow create: if isAuthenticated();
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // Admin logs collection
    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Public sports cache written only by Admin SDK (Cloud Functions)
    match /cache/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}