# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Environment settings
VITE_APP_ENV=development
VITE_USE_FIREBASE_EMULATOR=false
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_PERFORMANCE_MONITORING=false

# API Settings
VITE_API_TIMEOUT=10000
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,video/mp4,video/webm

# SEO Settings
VITE_SITE_NAME=AS 로마 코리아
VITE_SITE_DESCRIPTION=AS 로마 한국 팬 커뮤니티 - 최신 뉴스, 경기 정보, 팬 소통 공간
VITE_SITE_URL=http://localhost:5173
VITE_SITE_IMAGE=/images/og-image.jpg

# Performance Settings
VITE_LAZY_LOADING_THRESHOLD=300
VITE_IMAGE_QUALITY=85
VITE_ENABLE_PWA=false

# Cache Management
VITE_APP_VERSION=1.0.0